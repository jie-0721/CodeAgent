# CodeAgent 配置示例
#
# 用法：复制为 .env 并填入真实值（.env 已在 .gitignore 中，不会被提交）
#      cp .env.example .env
#
# 配置优先级：命令行参数 > 系统环境变量 > .env 文件 > 内置默认值

# ---------------------------------------------------------------------------
# LLM 接入（任意 OpenAI 兼容接口）
# ---------------------------------------------------------------------------
# 提供方：openai（OpenAI 兼容 HTTP 接口）或 mock（离线规则模型，无需 Key）
CODEAGENT_PROVIDER=openai

# DeepSeek（默认值）
CODEAGENT_BASE_URL=https://api.deepseek.com/v1
CODEAGENT_MODEL=deepseek-chat
CODEAGENT_API_KEY=sk-你的key

# --- 其他服务商示例（改上面三行即可）---
# 阿里云通义千问（DashScope OpenAI 兼容模式）
# CODEAGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# CODEAGENT_MODEL=qwen-plus
# CODEAGENT_API_KEY=sk-你的key
#
# OpenAI 官方
# CODEAGENT_BASE_URL=https://api.openai.com/v1
# CODEAGENT_MODEL=gpt-4o-mini
#
# 本地 Ollama（无需 Key，需要先 ollama serve）
# CODEAGENT_BASE_URL=http://localhost:11434/v1
# CODEAGENT_MODEL=qwen2.5-coder:7b
# CODEAGENT_API_KEY=ollama

# 也支持直接用这些通用变量名（按顺序探测）：
# OPENAI_API_KEY / DEEPSEEK_API_KEY / DASHSCOPE_API_KEY / MOONSHOT_API_KEY / ARK_API_KEY

# ---------------------------------------------------------------------------
# Agent 行为
# ---------------------------------------------------------------------------
CODEAGENT_TEMPERATURE=0.2
CODEAGENT_MAX_TOKENS=2048
CODEAGENT_TIMEOUT=60
CODEAGENT_MAX_RETRIES=3
CODEAGENT_MAX_STEPS=12
CODEAGENT_MEMORY_TOKENS=6000
CODEAGENT_STREAM=true

# 是否自动放行「写文件 / 执行代码」等有副作用的工具（默认 false，逐次询问）
CODEAGENT_AUTO_APPROVE=false

# 工具沙箱根目录（默认当前目录）
# CODEAGENT_WORKSPACE=.

# 会话保存目录
# CODEAGENT_SESSION_DIR=.codeagent/sessions
